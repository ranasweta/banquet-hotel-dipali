# Copy to .env.local and fill in. .env* is gitignored.

# PostgreSQL 16. Needs the pgcrypto and btree_gist extensions (db/schema.sql creates them).
DATABASE_URL=postgres://user:password@host:5432/hd

# Postgres connection pool size (default 5).
#
# Raise it for LOCAL development against a remote database. Several endpoints fetch their
# sources concurrently — /notifications reads eleven — and with only five connections those
# queries queue behind each other. Measured against Neon us-east-1 from India, /notifications
# went from ~17s to ~1.4s at DB_POOL_MAX=24 with no other change.
#
# Leave it at the default on Vercel: every serverless instance holds its OWN pool, so a large
# max multiplied by many warm instances is how a Postgres connection limit gets exhausted.
# Production does not need it anyway — the app and the database are both in us-east-1, so a
# query costs single-digit milliseconds there rather than ~250.
# DB_POOL_MAX=24

# A SEPARATE database. The integration suite truncates and reseeds it — never point
# this at the dev database. Tests skip entirely when it is unset.
TEST_DATABASE_URL=postgres://user:password@host:5432/hd_test

# Password given to every seeded user. Set this to something real before seeding any
# environment that is not your laptop; the seed falls back to a known default and warns.
SEED_PASSWORD=

# iron-session cookie encryption key. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing session (everyone is logged out).
SESSION_SECRET=

# AES-256-GCM key (base64-encoded 32 bytes) for encrypting KYC/Aadhaar files at rest
# (CLAUDE.md rule 7). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes previously stored documents undecryptable.
STORAGE_KEY=

# Shared secret the daily scheduler sends as `x-cron-secret` to POST /api/v1/cron/run.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# REQUIRED IN ANY DEPLOYED ENVIRONMENT. Unset, the endpoint answers every scheduler call with
# 403 and nothing else advances an event's status — so no booking ever reaches In Progress or
# Completed, and nothing can be locked, invoiced or billed (CLAUDE.md rule 8). The symptom
# appears weeks later and nowhere near the cause. Optional only on a laptop, where the Auditor
# can run the job by hand from the app.
CRON_SECRET=

# Cloud Storage bucket holding KYC/Aadhaar documents (CLAUDE.md rule 7). Name only, no
# gs:// prefix.
#
# Leave this UNSET locally: documents then go to ./storage, encrypted, which is the dev
# convenience. Set it in any deployed environment — Cloud Run's filesystem lives in the
# instance's memory and dies with it, so without a bucket an upload succeeds and the file is
# simply gone on the next revision. Since confirming an event requires both Aadhaar sides on
# record, that failure surfaces as "nothing can be confirmed". Unset on Cloud Run, an upload
# now throws instead.
#
# No credentials go with it: the client authenticates as the Cloud Run service account
# through ADC, so grant that account Storage Object Admin ON THE BUCKET and ship no key file.
# GCS_BUCKET=